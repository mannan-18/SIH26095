# Securesight (DoSJE Nigrani 2.0 Grid) - Environment Configuration

# Controls demo credentials availability (defaults to true when NODE_ENV !== "production")
# Set DEMO_MODE=false in production environments to lock down demo credentials
DEMO_MODE=true

# Server execution environment (development / production)
NODE_ENV=development

# Application HTTP Port (defaults to 3000)
PORT=3000
